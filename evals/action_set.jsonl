{"id": "as-014", "layer": "dispatch", "tool": "related_check", "args": {"topic": "x"}, "expect": "read_logged", "notes": "reads are auto-allowed AND logged — a row exists for every action"}
{"id": "as-015", "layer": "dispatch", "tool": "groundwork_sync", "args": {}, "dry_run": true, "expect": "executed_dry", "notes": "sync dry-run: approval exercised, would-be call stored, worker never spawns"}
{"id": "as-016", "layer": "payload", "tool": "em_draft_kb", "args": {"title": "Agent memory (draft)", "body_markdown": "...", "provenance": {"research_run_id": "3e78a096", "citations": ["20bd36d3"]}}, "expect": "require_approval", "payload_must_contain": ["research_run_id", "3e78a096"], "notes": "the EM-seam payload: approver always sees WHICH research run produced the draft"}
